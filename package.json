{
  "name": "lopes-ui",
  "version": "1.2.0",
  "description": "React component library built with Next.js, Tailwind CSS v4 and TypeScript",
  "keywords": [
    "react",
    "next.js",
    "tailwindcss",
    "component-library",
    "radix-ui",
    "ui"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.mjs",
      "require": "./dist/primitives.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.mjs",
      "require": "./dist/rich-text.js"
    },
    "./spreadsheet": {
      "types": "./dist/spreadsheet.d.ts",
      "import": "./dist/spreadsheet.mjs",
      "require": "./dist/spreadsheet.js"
    },
    "./code-block": {
      "types": "./dist/code-block.d.ts",
      "import": "./dist/code-block.mjs",
      "require": "./dist/code-block.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "lopes-ui": "./dist/cli.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "tsup",
    "prepare": "tsup",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-table": ">=8.0.0",
